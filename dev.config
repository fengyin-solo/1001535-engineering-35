# 本地开发配置：前端、后端与代理目标都从这一份文件读。
# 改端口只需要改这里，然后重新执行 ./dev.sh（或 make dev）。
# 说明：见 README「本地配置」一节；环境变量可临时覆盖这里的值。

# 后端 uvicorn 监听地址与端口
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# 前端 vite dev server 监听地址与端口
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173

# 前端 /api 代理目标；留空时自动按 BACKEND_HOST:BACKEND_PORT 推导，
# 只有后端不在本机（例如联调远程环境）时才需要手工填写。
#VITE_PROXY_TARGET=
